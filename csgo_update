#!/bin/sh
set -eu

curl -L https://github.com/SteamRE/DepotDownloader/releases/latest/download/DepotDownloader-linux-x64.zip | bsdtar xf - -C /tmp DepotDownloader
chmod +x /tmp/DepotDownloader
/tmp/DepotDownloader -app 730 -depot 731 -branch csgo -dir .
echo 'regex:^(?!csgo_linux64)' | /tmp/DepotDownloader -app 730 -depot 734 -branch csgo -username "$1" -password "$2" -dir . -filelist /dev/stdin

mkdir -p .steam/sdk64
curl -L https://github.com/Detanup01/gbe_fork/releases/latest/download/emu-linux-release.tar.bz2 | bsdtar xf - --strip-components=3 -C .steam/sdk64 release/regular/x64/steamclient.so
curl -L https://github.com/GT-610/csgo-gc/releases/latest/download/csgo_gc-ubuntu-latest.zip | bsdtar xf - 'csgo_gc/*' csgo_linux64
chmod +x csgo_linux64

curl -L https://repo.steampowered.com/steamrt-images-scout/snapshots/latest-public-stable/steam-runtime.tar.xz | bsdtar xf -
